SCHOLAR_RAG_DATABASE_PATH=.scholar-rag-agent.sqlite3
SCHOLAR_RAG_AGENT_ID=local-agent
SCHOLAR_RAG_RETRIEVAL_TIMEOUT_SECONDS=30
SCHOLAR_RAG_REASONING_TIMEOUT_SECONDS=60
SCHOLAR_RAG_MAX_SOURCE_DOCS=50
SCHOLAR_RAG_MAX_HOPS=5
# Provider family for DEFAULT tasks and missing-provider fallbacks, not a model ID.
SCHOLAR_RAG_DEFAULT_MODEL=openai
SCHOLAR_RAG_OPENAI_MODEL=gpt-6-astra
SCHOLAR_RAG_ANTHROPIC_MODEL=claude-sonnet-5
SCHOLAR_RAG_GEMINI_MODEL=gemini-3.8-flash
SCHOLAR_RAG_KIMI_MODEL=kimi-k3
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
